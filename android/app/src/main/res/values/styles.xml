<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight follows the system light or dark mode. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/ffmuc_background</item>
        <item name="colorAccent">@color/ffmuc_accent</item>
        <item name="colorPrimary">@color/ffmuc_background</item>
        <item name="android:statusBarColor">@color/ffmuc_background</item>
        <item name="android:navigationBarColor">@color/ffmuc_background</item>
        <item name="android:windowLightStatusBar">@bool/ffmuc_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/ffmuc_light_bars</item>
    </style>
</resources>
